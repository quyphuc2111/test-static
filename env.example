# Database Configuration
# MySQL database URL for Prisma
DATABASE_URL="mysql://appuser:apppass@127.0.0.1:3306/appdb"

# Alternative database configuration (if you prefer individual variables)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=appuser
# DB_PASSWORD=apppass
# DB_NAME=appdb

# Next.js Configuration
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Session Configuration
SESSION_PASSWORD="your-session-password-here-must-be-at-least-32-characters-long"
SESSION_COOKIE_NAME="bkt_session"

# Application Configuration
NODE_ENV="development"
