# Dùng cấu trúc node_modules phẳng (flat) giống npm/yarn thay vì symlinked .pnpm.
# Mục đích: Prisma generate sẽ tạo node_modules/.prisma/client đúng vị trí top-level,
# Next.js standalone tracing và Docker COPY hoạt động đúng.
node-linker=hoisted

# Hoist thêm các package liên quan Prisma cho chắc chắn (defensive khi build context khác).
public-hoist-pattern[]=*prisma*
public-hoist-pattern[]=@prisma/*
